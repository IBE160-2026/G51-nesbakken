# Copy this file to .env and fill in real values. Never commit .env itself.

# OpenRouteService API key — used for the walking-route distance/duration
# matrix (services.py). Free tier: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# OpenAI API key — used for AI stop-selection (ai.py). Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which OpenAI model to use for stop-selection. Example: gpt-4o-mini
OPENAI_MODEL=
